# Environment Variables Example for Finance AI Consultant

# App Config
VITE_APP_TITLE="CermatUsaha - Konsultan Keuangan AI"
VITE_APP_ENV="development"

# API Endpoints (Fallback to simulated offline mock if not set)
VITE_API_BASE_URL="http://localhost:3000/api"

# Gemini API key untuk Cermat AI (buat di https://aistudio.google.com/apikey)
# Sengaja TANPA awalan VITE_ supaya tidak ikut terkirim ke browser.
GEMINI_API_KEY=""
